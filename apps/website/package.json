    "knip": "knip"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wehrli/design-system": "workspace:*",
    "botid": "^1.5.13",
    "canvas-confetti": "^1.9.4",
    "datocms-structured-text-utils": "^6.0.1",
    "graphql": "^16.15.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-datocms": "^8.1.2",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "three": "^0.187.0"
