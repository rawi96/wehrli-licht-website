    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/env": "^16.4.6",
    "@next/eslint-plugin-next": "^16.4.6",
    "@smartive/eslint-config": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "knip": "^6.46.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0"
  }
