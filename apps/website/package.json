{
  "name": "@wehrli/website",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "pnpm generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
