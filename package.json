{
  "name": "wehrli-licht",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev --filter=@wehrli/website",
    "build": "turbo build",
    "lint": "turbo lint",
    "website:build": "turbo build --filter=@wehrli/website",
    "design-system:dev": "pnpm --filter @wehrli/design-system storybook",
    "design-system:build": "turbo build --filter=@wehrli/design-system"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "@smartive/prettier-config": "3.1.2",
    "turbo": "^2.11.10"
  }
}
